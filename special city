class Solution {
    public String solve(int n, int x, int y) {
        int[] ans = new int[n];
        
        for(int i=1;i<=n;i++) {
            for (int j=i+1;j<=n;j++) {
                int d=j-i; 
                if(i<=x && y<=j) {
                    int k=(x-i)+(j-y)+1;
                    d= Math.min(d, k);
                }
                ans[d]++;
            }
        }
        StringBuilder sb=new StringBuilder();
        for (int k=1;k<n;k++) {
            sb.append(ans[k]).append(" ");
        }
        return sb.toString().trim();
    }
}



class Solution {
    public long nthPrime(int n) {
        if (n == 1) return 2;
        int limit = (int)(n * (Math.log(n) + Math.log(Math.log(n)))) + 10;

        boolean[] isPrime = new boolean[limit + 1];
        Arrays.fill(isPrime, true);

        isPrime[0] = false;
        isPrime[1] = false;

        for (int i = 2; i * i <= limit; i++) {
            if (isPrime[i]) {
                for (int j = i * i; j <= limit; j += i) {
                    isPrime[j] = false;
                }
            }
        }

        int count = 0;
        for (int i = 2; i <= limit; i++) {
            if (isPrime[i]) {
                count++;
                if (count == n) return i;
            }
        }

        return -1;
    }
}
